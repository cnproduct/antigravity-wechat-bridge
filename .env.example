# ================================================================
# Antigravity WeChat Bridge 配置文件模版 (.env)
# ================================================================

# --- 企业微信 (WeCom) 应用配置 ---
# 企业 ID (可在企业微信管理后台「我的企业」底部找到)
WECHAT_CORP_ID=ww_your_corpid_here

# 自建应用 AgentId (可在「应用管理」- 自建应用详情页找到)
WECHAT_AGENT_ID=1000002

# 自建应用 Secret (可在自建应用详情页获取)
WECHAT_CORP_SECRET=your_wechat_app_secret_here

# 接收消息服务器配置 (进入应用详情页「设置接收消息」时生成)
WECHAT_TOKEN=your_token_random_string_here
WECHAT_ENCODING_AES_KEY=your_43_characters_encoding_aes_key_here

# --- 安全与权限控制 ---
# 允许向 Agent 下达任务的企业微信成员 UserID 列表（英文逗号分隔）
# 填入自己的 UserID，防止企业内部其他成员滥用终端 Agent
ALLOWED_USER_IDS=happy,admin

# --- Antigravity Agent 执行环境配置 ---
# 默认操作的工作区目录绝对路径
AGENT_DEFAULT_WORKSPACE=/Users/happy/Library/CloudStorage/GoogleDrive-cnproduct@gmail.com/我的云端硬盘/WPS同步盘/diaperwebsites

# Antigravity 本地数据目录 (存储 artifacts, scratch, session 等)
ANTIGRAVITY_APP_DATA_DIR=/Users/happy/.gemini/antigravity

# Agent 驱动模型 (默认 gemini-3.8-flash 或 gemini-3.8-flash-high)
AGENT_MODEL=gemini-3.8-flash

# Antigravity Skills 目录（可配置多个路径，英文逗号分隔）
AGENT_SKILLS_PATHS=/Users/happy/.gemini/config/skills

# --- 多租户沙盒物理隔离与并发控制配置 ---
# 租户沙盒根目录（每个微信用户与会话生成独立子目录，存放上传文件与产物，物理杜绝串联）
TENANTS_DIR=~/.gemini/antigravity/tenants

# 会话持久化映射存储路径 (记录 WeChat UserID <-> ConversationID)
SESSION_STORE_PATH=~/.gemini/antigravity/wechat_sessions.json

# 单机最大并发执行 Agent 任务数（建议：4G内存填3，8G内存填5，16G填15，超出自动排队）
MAX_CONCURRENT_TASKS=5

# 微信临时上传文件自动保留天数（超过自动清理）
FILE_RETENTION_DAYS=7

# --- 本地网关服务配置 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
